=  Bun
```bash
bun install sqlite-tg
```

```ts
import { Database } from "bun:sqlite";
import * as sqliteTg from "sqlite-tg";

const db = new Database(":memory:");
sqliteTg.load(db);

const { tg_version } = db
  .prepare("select tg_version() as tg_version",)
  .get();

console.log(tg_version);
```

=  Deno
```bash
deno add npm:sqlite-tg
```

```ts
// sqlite-tg with Deno
import { Database } from "jsr:@db/sqlite@0.11";
import * as sqliteTg from "npm:sqlite-tg@latest";

const db = new Database(":memory:");
db.enableLoadExtension = true;
sqliteTg.load(db);
db.enableLoadExtension = false;

const [tgVersion] = db
  .prepare("select tg_version()")
  .value<[string]>();

console.log(tgVersion);
```

