Source: ../api.sql
select
    tg_holes_each.rowid as "tg_holes_each.rowid",
    json_each.rowid as "json_each.rowid",
    json_each.key,
    tg_to_wkt(hole)
  from json_each('[
    "POLYGON ((1 1, 2 2, 1 1), (3 3, 4 4, 3 3))",
    "POLYGON ((1 1, 2 2, 1 1), (5 5, 6 6, 5 5), (7 7, 8 8, 7 7))",
  ]')
  join tg_holes_each(json_each.value);
---
{
	 tg_holes_each.rowid: 0
	 json_each.rowid: 0
	 key: 0
	 tg_to_wkt(hole): 'POLYGON((3 3,4 4,3 3))'
}
{
	 tg_holes_each.rowid: 0
	 json_each.rowid: 1
	 key: 1
	 tg_to_wkt(hole): 'POLYGON((5 5,6 6,5 5))'
}
{
	 tg_holes_each.rowid: 1
	 json_each.rowid: 1
	 key: 1
	 tg_to_wkt(hole): 'POLYGON((7 7,8 8,7 7))'
}

