Source: ../api.sql
select
  value,
  tg_bbox.*
from json_each('[
  "POINT (1 1)",
  "POLYGON ((1 1, 2 2, 3 3, 1 1))",
  "MULTIPOLYGON (((1 1, 2 2, 3 3, 1 1)), ((4 4, 5 5, 6 6, 4 4)))",
  "LINESTRING (4 4, 6 6, 7 7)",
]')
join tg_bbox(value);
---
{
	 value: 'POINT (1 1)'
	 minX: 1.0
	 maxX: 1.0
	 minY: 1.0
	 maxY: 1.0
}
{
	 value: 'POLYGON ((1 1, 2 2, 3 3, 1 1))'
	 minX: 1.0
	 maxX: 3.0
	 minY: 1.0
	 maxY: 3.0
}
{
	 value: 'MULTIPOLYGON (((1 1, 2 2, 3 3, 1 1)), ((4 4, 5 5, 6 6, 4 4)))'
	 minX: 1.0
	 maxX: 6.0
	 minY: 1.0
	 maxY: 6.0
}
{
	 value: 'LINESTRING (4 4, 6 6, 7 7)'
	 minX: 4.0
	 maxX: 7.0
	 minY: 4.0
	 maxY: 7.0
}

