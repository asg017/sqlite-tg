Source: ../api.sql
select
    rowid,
    line,
    tg_to_wkb(line),
    tg_to_wkt(line),
    tg_to_geojson(line)
  from tg_lines_each('MULTILINESTRING ((10 40, 40 30), (20 20, 30 10))');
---
{
	 rowid: 0
	 line: pointer[]
	 tg_to_wkb(line): X'0102000000020000000000000000002440000000000000444000000000000044400000000000003e40'
	 tg_to_wkt(line): 'LINESTRING(10 40,40 30)'
	 tg_to_geojson(line): (json) '{"type":"LineString","coordinates":[[10,40],[40,30]]}'
}
{
	 rowid: 1
	 line: pointer[]
	 tg_to_wkb(line): X'010200000002000000000000000000344000000000000034400000000000003e400000000000002440'
	 tg_to_wkt(line): 'LINESTRING(20 20,30 10)'
	 tg_to_geojson(line): (json) '{"type":"LineString","coordinates":[[20,20],[30,10]]}'
}

