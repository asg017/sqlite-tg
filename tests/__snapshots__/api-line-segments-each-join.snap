Source: ../api.sql
select
    json_each.key,
    tg_line_segments_each.rowid,
    ax, ay, bx, by
  from json_each('[
    "LINESTRING (10 40, 40 30)",
    "LINESTRING (20 20, 30 10, 15 15)",
  ]')
  join tg_line_segments_each(value);
