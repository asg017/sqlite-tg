Source: ../api.sql
select
    json_each.key,
    tg_geometries_each.rowid,
    geometry,
    tg_to_wkb(geometry),
    tg_to_wkt(geometry),
    tg_to_geojson(geometry)
  from json_each('[
    "GEOMETRYCOLLECTION (POINT (10 20), LINESTRING (30 40, 50 60))",
    "GEOMETRYCOLLECTION (POLYGON ((10 20, 30 40, 50 60, 10 20)))",
   ]')
   join tg_geometries_each(value);
---
{
	 key: 0
	 rowid: 0
	 geometry: pointer[]
	 tg_to_wkb(geometry): X'010100000000000000000024400000000000003440'
	 tg_to_wkt(geometry): 'POINT(10 20)'
	 tg_to_geojson(geometry): (json) '{"type":"Point","coordinates":[10,20]}'
}
{
	 key: 0
	 rowid: 1
	 geometry: pointer[]
	 tg_to_wkb(geometry): X'0102000000020000000000000000003e40000000000000444000000000000049400000000000004e40'
	 tg_to_wkt(geometry): 'LINESTRING(30 40,50 60)'
	 tg_to_geojson(geometry): (json) '{"type":"LineString","coordinates":[[30,40],[50,60]]}'
}
{
	 key: 1
