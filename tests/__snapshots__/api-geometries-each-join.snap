	 tg_to_wkt(geometry): 'POLYGON((10 20,30 40,50 60,10 20))'
	 tg_to_geojson(geometry): (json) '{"type":"Polygon","coordinates":[[[10,20],[30,40],[50,60],[10,20]]]}'
}

