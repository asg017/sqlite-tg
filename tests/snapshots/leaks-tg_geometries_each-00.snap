select 
    rowid, 
    geometry, 
    tg_to_wkb(geometry),
    tg_to_wkt(geometry),
    tg_to_geojson(geometry)
  from tg_geometries_each('GEOMETRYCOLLECTION (POINT (10 20), LINESTRING (30 40, 50 60))');
