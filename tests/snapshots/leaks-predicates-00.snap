Source: ../leaks.sql
select
  a,
  b,
  tg_contains(a, b),
  tg_contains(b, a),
  tg_coveredby(a, b),
  tg_coveredby(b, a),
  tg_covers(a, b),
  tg_covers(b, a),
  tg_disjoint(a, b),
  tg_disjoint(b, a),
  tg_intersects(a, b),
  tg_intersects(b, a),
  tg_touches(a, b),
  tg_touches(b, a),
  tg_within(a, b),
  tg_within(b, a)
from predicate_test_cases;
---
{
	 a: 'POINT (1 1)'
	 b: 'POINT (1 1)'
	 tg_contains(a, b): 1
	 tg_contains(b, a): 1
	 tg_coveredby(a, b): 1
	 tg_coveredby(b, a): 1
	 tg_covers(a, b): 1
	 tg_covers(b, a): 1
	 tg_disjoint(a, b): 0
	 tg_disjoint(b, a): 0
	 tg_intersects(a, b): 1
	 tg_intersects(b, a): 1
	 tg_touches(a, b): 0
	 tg_touches(b, a): 0
	 tg_within(a, b): 1
	 tg_within(b, a): 1
}

